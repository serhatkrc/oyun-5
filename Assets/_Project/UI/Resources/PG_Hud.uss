/* PixelGenesis HUD (Faz 1 basic version; theme variables arrive with the full UI in Faz 10). */

.pg-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

.pg-bar {
    background-color: rgba(18, 21, 28, 0.88);
    padding: 4px 6px;
    flex-direction: row;
    align-items: center;
}

.pg-topbar {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
}

.pg-bottom {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(18, 21, 28, 0.88);
    padding: 4px 6px;
}

.pg-row {
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
}

.pg-spacer {
    flex-grow: 1;
}

.pg-label {
    color: rgb(232, 232, 232);
    margin: 0 8px;
    -unity-text-align: middle-left;
}

.pg-date {
    color: rgb(255, 236, 170);
    -unity-font-style: bold;
    min-width: 150px;
}

.pg-button {
    min-width: 40px;
    margin: 2px;
    padding: 3px 8px;
    background-color: rgb(45, 50, 60);
    color: rgb(232, 232, 232);
    border-width: 0;
    border-radius: 3px;
}

.pg-button:hover {
    background-color: rgb(62, 70, 86);
}

.pg-button--selected {
    background-color: rgb(75, 123, 209);
}

.pg-button--danger {
    background-color: rgb(140, 50, 45);
}

.pg-tab {
    min-width: 90px;
}

.pg-toasts {
    position: absolute;
    right: 8px;
    top: 44px;
    width: 300px;
}

.pg-toast {
    background-color: rgba(30, 34, 42, 0.94);
    color: rgb(240, 240, 240);
    padding: 6px 8px;
    margin-bottom: 4px;
    border-radius: 3px;
    white-space: normal;
}

.pg-debug {
    position: absolute;
    left: 8px;
    top: 44px;
    background-color: rgba(0, 0, 0, 0.65);
    color: rgb(184, 245, 184);
    font-size: 12px;
    padding: 6px 8px;
    white-space: normal;
}

.pg-window {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    background-color: rgba(24, 27, 35, 0.97);
    border-color: rgb(80, 90, 110);
    border-width: 1px;
    border-radius: 4px;
    padding: 10px 12px;
    min-width: 520px;
}

.pg-window-title {
    color: rgb(255, 236, 170);
    font-size: 18px;
    -unity-font-style: bold;
    margin-bottom: 8px;
}

.pg-window .unity-label {
    color: rgb(220, 220, 220);
}

.pg-worldgen-body {
    flex-direction: row;
}

.pg-worldgen-fields {
    width: 420px;
    margin-right: 12px;
}

.pg-preview {
    width: 256px;
    height: 256px;
    background-color: rgb(10, 12, 16);
}

.pg-slot {
    flex-direction: row;
    align-items: center;
    margin-bottom: 4px;
    background-color: rgba(40, 45, 56, 0.8);
    padding: 4px;
}

.pg-slot-thumb {
    width: 56px;
    height: 56px;
    margin-right: 8px;
    background-color: rgb(10, 12, 16);
}

.pg-slot-info {
    flex-grow: 1;
    color: rgb(230, 230, 230);
    white-space: normal;
}

.pg-fatal {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(50, 10, 10, 0.95);
    padding: 24px;
}

.pg-fatal-text {
    color: rgb(255, 220, 220);
    white-space: normal;
    margin-bottom: 4px;
}
